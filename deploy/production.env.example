# Copy this file to the repository root as `.env.production` before running:
# docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

POSTGRES_USER=travel
# Use a long random password. Prefer letters and numbers here so DATABASE_URL stays valid.
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=travel
# Keep false for the bundled Docker PostgreSQL.
# Set DATABASE_SSL=true only when using an external provider that requires SSL.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

FIREBASE_PROJECT_ID=travel-b226f
CORS_ORIGINS=https://demovn.com,https://www.demovn.com

NEXT_PUBLIC_API_BASE_URL=https://demovn.com/api/v1
NEXT_PUBLIC_DEFAULT_TRIP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_TO_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=travel-b226f.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=travel-b226f
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=travel-b226f.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=620185931766
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_TO_FIREBASE_WEB_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional provider overrides.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
