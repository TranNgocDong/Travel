NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Production must use PostgreSQL. Do not leave this empty.
DATABASE_URL=postgres://travel:CHANGE_ME@127.0.0.1:5432/travel

# Firebase Auth project used to verify frontend ID tokens.
FIREBASE_PROJECT_ID=travel-b226f

# If frontend and backend share demovn.com through a reverse proxy, CORS is rarely hit.
# Keep this exact and do not use "*" with credentials.
CORS_ORIGINS=https://demovn.com,https://www.demovn.com
