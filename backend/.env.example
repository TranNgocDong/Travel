PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Enable PostgreSQL persistence by setting DATABASE_URL.
# Example:
# DATABASE_URL=postgres://travel:travel_dev_password@localhost:5432/travel
DATABASE_URL=

# Firebase Auth project used to verify frontend ID tokens.
FIREBASE_PROJECT_ID=travel-b226f

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
